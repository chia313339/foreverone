{
  "hosting": {
    "target": "foreverone",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "Dockerfile",
      "optimize_images.py",
      "build_v2_assets.py",
      "tools/**",
      "package-lock.json",
      "README.md",
      "FIREBASE_DEPLOY.md",
      "CLAUDE.md",
      "img/_old_v1/**",
      "img/**/*.png",
      "img/*.mp4",
      "img/*.webm",
      "js/swiper-bundle.min.js",
      "css/swiper-bundle.min.css",
      ".dockerignore",
      ".claude/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
